// Demo of the table lib. Run from examples/:
//   zz install && zz run demo.zz
import std.colors

import table

func main() {
    // Pipeline style: one binding, no rebind chain.
    table.new(["NAME", "AGE", "CITY"])
        |> table.add_row(["Alice", "25", "New York"])
        |> table.add_row(["Bob", "30", "Boston"])
        |> table.set_align(1, "right")
        |> table.render()
        |> println()
    // Title + footer (totals).
    table.new(["ITEM", "QTY"])
        |> table.add_row(["apples", "10"])
        |> table.add_row(["oranges", "4"])
        |> table.set_title("Stock")
        |> table.set_footer(["Total", "14"])
        |> table.print()
    // Colors compose freely — widths stay aligned.
    table.new([colors.bold("NAME"), colors.bold("AGE")])
        |> table.add_row(["Alice", colors.green("25")])
        |> table.add_row(["Bob", colors.red("30")])
        |> table.print()
    // Long cells truncate cleanly instead of stretching the column.
    table.new(["NOTE"])
        |> table.add_row(["a very long note that would stretch the table"])
        |> table.set_max_width(20)
        |> table.render()
        |> println()
    // JSON straight into a table.
    table.from_json(["id", "name"], "[{\"id\": 1, \"name\": \"ada\"}]")
        |> table.render()
        |> println()
    // Markdown output for docs and issues.
    table.new(["NAME", "AGE"])
        |> table.add_row(["Alice", "25"])
        |> table.set_style("markdown")
        |> table.render()
        |> println()
    println("demo_ok")
}
