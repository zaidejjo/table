// v02_test.zz — max-width truncation, per-column caps, from_json.
import std.colors

import table

@test
func test_max_width_truncates() {
    t := table.new(["NAME"])
    t = table.add_row(t, ["alexander"])
    t = table.set_max_width(t, 5)
    got := table.render(t)
    want := "╭───────╮\n│ NAME  │\n├───────┤\n│ alex… │\n╰───────╯\n"
    assert_eq(got, want)
}

@test
func test_max_width_short_cells_untouched() {
    t := table.new(["A"])
    t = table.add_row(t, ["xy"])
    t = table.set_max_width(t, 10)
    assert_eq(table.render(t), "╭────╮\n│ A  │\n├────┤\n│ xy │\n╰────╯\n")
}

@test
func test_col_cap_overrides_global() {
    t := table.new(["A", "B"])
    t = table.add_row(t, ["aaaaaa", "bbbbbb"])
    t = table.set_max_width(t, 4)
    t = table.set_col_max_width(t, 1, 6)
    got := table.render(t)
    assert(got.contains("aaa…"))
    assert(got.contains("bbbbbb"))
}

@test
func test_col_cap_bad_index_ignored() {
    t := table.new(["A"])
    t = table.add_row(t, ["abc"])
    t = table.set_col_max_width(t, 9, 1)
    t = table.set_max_width(t, 0 - 5)
    assert(table.render(t).contains("abc"))
}

@test
func test_truncate_colored_no_bleed() {
    t := table.new(["A"])
    t = table.add_row(t, [colors.green("abcdef")])
    t = table.set_max_width(t, 4)
    got := table.render(t)
    assert_eq(table.visible_len(got.split("\n")[3]), 8)
    assert(got.contains("…"))
}

@test
func test_truncate_applies_markdown_minimal() {
    t := table.new(["A"])
    t = table.add_row(t, ["abcdef"])
    t = table.set_max_width(t, 3)
    md := table.render(table.set_style(t, "markdown"))
    assert(md.contains("ab…"))
    mn := table.render(table.set_style(t, "minimal"))
    assert(mn.contains("ab…"))
}

@test
func test_from_json_arrays() {
    t := table.from_json(["A", "B"], "[[\"x\", 1], [\"yy\", true]]")
    got := table.render(t)
    assert(got.contains("x"))
    assert(got.contains("yy"))
    assert(got.contains("true"))
}

@test
func test_from_json_objects() {
    t := table.from_json(["id", "name"], "[{\"id\": 1, \"name\": \"a\"}, {\"id\": 2}]")
    got := table.render(t)
    assert(got.contains("2"))
    assert(got.contains("a"))
}

@test
func test_from_json_derives_headers() {
    t := table.from_json([], "[{\"id\": 1}]")
    assert(table.render(t).contains("id"))
}

@test
func test_from_json_invalid_is_empty() {
    t := table.from_json(["A"], "nope{")
    assert_eq(table.render(t), "╭───╮\n│ A │\n╰───╯\n")
    t2 := table.from_json(["A"], "{\"a\": 1}")
    assert_eq(table.render(t2), "╭───╮\n│ A │\n╰───╯\n")
}

@test
func test_pipeline_fluent_style() {
    t := table.new(["A", "B"])
        |> table.add_row(["1", "22"])
        |> table.set_align(1, "right")
        |> table.set_title("T")
        |> table.set_max_width(10)
    got := table.render(t)
    assert(got.contains("22"))
    assert(got.contains("T"))
}

@test
func test_dotted_chaining_style() {
    // Dotted chains need a post-0.1.6 toolchain natively (method
    // dispatch fix); VM has always accepted them. zz test is VM-only.
    got := table.render(table.new(["A"]).add_row(["1"]).set_title("T"))
    assert(got.contains("1"))
    assert(got.contains("T"))
}

@test
func test_auto_align_numbers_right() {
    t := table.new(["ITEM", "QTY", "PRICE"])
    t = table.add_row(t, ["apples", "10", "1.5"])
    t = table.add_row(t, ["oranges", "4", "12.25"])
    got := table.render(t)
    assert(got.contains("│  10 │"))
    assert(got.contains("│   1.5 │"))
    assert(got.contains("│ apples  │"))
}

@test
func test_auto_align_explicit_wins() {
    t := table.new(["N"])
    t = table.add_row(t, ["7"])
    t = table.set_align(t, 0, "left")
    assert(table.render(t).contains("│ 7 │"))
    t = table.set_align(t, 0, "auto")
    assert(table.render(t).contains("│ 7 │"))
}

@test
func test_auto_align_text_stays_left() {
    t := table.new(["A", "B"])
    t = table.add_row(t, ["x", "1"])
    t = table.add_row(t, ["yz", "nope"])
    got := table.render(t)
    assert(got.contains("│ yz │ nope │"))
}

@test
func test_from_dicts() {
    rows := [{"id": 1, "name": "a"}, {"id": 22, "name": "bb"}]
    t := table.from_dicts(["id", "name"], rows)
    got := table.render(t)
    assert(got.contains("22"))
    assert(got.contains("bb"))
    assert(got.contains("id"))
}

@test
func test_max_rows_note() {
    t := table.new(["A"])
    t = table.add_row(t, ["1"])
    t = table.add_row(t, ["2"])
    t = table.add_row(t, ["3"])
    t = table.set_max_rows(t, 2)
    got := table.render(t)
    // Single "A"/"1"/"2" column is numeric → auto right-aligned.
    want := "╭───────────╮\n│         A │\n├───────────┤\n│         1 │\n│         2 │\n├───────────┤\n│ … +1 more │\n╰───────────╯\n"
    assert_eq(got, want)
}

@test
func test_max_rows_off_and_fit() {
    t := table.new(["A"])
    t = table.add_row(t, ["1"])
    t = table.set_max_rows(t, 5)
    assert(table.render(t).contains("1"))
    t = table.set_max_rows(t, 0 - 3)
    assert(table.render(t).contains("1"))
}

@test
func test_max_rows_minimal_markdown() {
    t := table.new(["A"])
    t = table.add_row(t, ["1"])
    t = table.add_row(t, ["2"])
    t = table.set_max_rows(t, 1)
    mn := table.render(table.set_style(t, "minimal"))
    assert(mn.contains("+1 more"))
    md := table.render(table.set_style(t, "markdown"))
    assert(md.contains("+1 more"))
}
