// v06_test.zz — from_csv / from_csv_delim via std.csv.
import table

@test
func test_from_csv_golden() {
    t := table.from_csv(["ID", "NAME"], "1,alice\n2,bob\n")
    got := table.render(t)
    want := "╭────┬───────╮\n│ ID │ NAME  │\n├────┼───────┤\n│  1 │ alice │\n│  2 │ bob   │\n╰────┴───────╯\n"
    assert_eq(got, want)
}

@test
func test_from_csv_derives_headers() {
    t := table.from_csv([], "id,name\n1,a\n")
    got := table.render(t)
    assert(got.contains("id"))
    assert(got.contains("name"))
    assert(got.contains("a"))
}

@test
func test_from_csv_quoted() {
    t := table.from_csv(["A", "B"], "\"x, y\",\"say \"\"hi\"\"\"\n")
    got := table.render(t)
    assert(got.contains("x, y"))
    assert(got.contains("say \"hi\""))
}

@test
func test_from_csv_invalid_is_empty() {
    t := table.from_csv(["A"], "")
    assert_eq(table.render(t), "╭───╮\n│ A │\n╰───╯\n")
}

@test
func test_from_csv_ragged() {
    t := table.from_csv(["A", "B"], "1\n2,3,4\n")
    got := table.render(t)
    assert(got.contains("1"))
    assert(got.contains("4"))
}

@test
func test_from_csv_delim() {
    t := table.from_csv_delim(["A", "B"], "1;2\n3;4\n", ";")
    got := table.render(t)
    assert(got.contains("1"))
    assert(got.contains("4"))
    assert_eq(got.contains(";"), false)
}

@test
func test_from_csv_delim_invalid_is_empty() {
    t := table.from_csv_delim(["A"], "", ";")
    assert_eq(table.render(t), "╭───╮\n│ A │\n╰───╯\n")
}

@test
func test_csv_round_trip() {
    t := table.new(["A", "B"])
    t = table.add_row(t, ["x, y", "z"])
    back := table.from_csv([], table.to_csv(t))
    assert_eq(table.render(back), table.render(t))
}
